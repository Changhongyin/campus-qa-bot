# 复制本文件为 .env 并填入你自己的配置（严禁提交到代码仓库）

# DeepSeek API 配置
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=45000

# GitHub 贡献频道（如留空则关闭）
# PAT 权限：此仓库的 Contents (read/write) 和 Pull requests (read/write)
GITHUB_TOKEN=
GITHUB_OWNER=Changhongyin
GITHUB_REPO=campus-qa-bot
GITHUB_API_BASE=https://api.github.com
GITHUB_BASE_BRANCH=main

# 贡献模式：pr（默认，开 PR）、direct（直接提交）、local（本地测试）
CONTRIBUTION_MODE=pr
CONTRIBUTION_MAX_BYTES=204800

# 上传和反馈的速率限制（per IP）
UPLOAD_RATE_HOUR=3
UPLOAD_RATE_DAY=10

# 流式聊天配置
SSE_HEARTBEAT_MS=15000

# 本地服务配置
PORT=3000
RATE_LIMIT_PER_MIN=120
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 可选：API 密钥鉴权
API_AUTH_KEY=

# 可选：检索引擎强制模式（auto | tfidf，Vercel 默认为 tfidf）
RETRIEVER_MODE=auto
